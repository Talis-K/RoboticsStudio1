<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="TreeStump">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="stump_link">
      <collision name="stump_collision">
        <geometry>
          <mesh>
            <!-- Local model -->
            <uri>model://tree_stump/meshes/TreeStump.obj</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="stump_visual">
        <geometry>
          <mesh>
            <uri>model://tree_stump/meshes/TreeStump.obj</uri>
          </mesh>
        </geometry>

        <!-- PBR workflow (metal/rough) -->
        <material>
          <pbr>
            <metal>
              <!-- REQUIRED: base color (sRGB). If you don't have it yet, point to Preview1 as a placeholder -->
              <albedo_map>model://tree_stump/materials/textures/TreeStump024_BaseColor.png</albedo_map>

              <!-- Normal map expects tangent-space normals; you only have a bump/height map.
                   It will still work as a soft normal in Ignition, but proper normal is better. -->
              <normal_map>model://tree_stump/materials/textures/TreeStump024_BUMP_4K_METALNESS.png</normal_map>

              <!-- Linear textures (NOT sRGB) -->
              <roughness_map>model://tree_stump/materials/textures/TreeStump024_ROUGHNESS_4K_METALNESS.png</roughness_map>
              <metalness_map>model://tree_stump/materials/textures/TreeStump024_METALNESS_4K_METALNESS.png</metalness_map>
              <ambient_occlusion_map>model://tree_stump/materials/textures/TreeStump024_AO_4K_METALNESS.png</ambient_occlusion_map>

              <!-- Optional scalars if you want to bias the maps -->
              <roughness>1.0</roughness>
              <metalness>1.0</metalness>
            </metal>
          </pbr>

          <!-- Optional: a little ambient to avoid a black look in dark worlds -->
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>

        <cast_shadows>true</cast_shadows>
        <!-- Uncomment if the mesh has open geometry and looks invisible from inside -->
        <!-- <double_sided>true</double_sided> -->
      </visual>
    </link>
  </model>
</sdf>
